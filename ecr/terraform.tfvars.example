# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.
#
# This repository is public, so the example carries a placeholder rather than
# the live account id.

account_id = "REPLACE-WORKLOAD-ACCOUNT-ID" # guards against applying elsewhere
region     = "us-east-1"
org_prefix = "u25c"

# One key per image. The key is the short name; the repository is created as
# <org_prefix>/<key>, so "api" becomes "u25c/api".
#
# Defaults are IMMUTABLE tags and scan-on-push. IMMUTABLE means a tag can never
# be repointed at different bytes - re-pushing :latest fails on purpose, which
# is what makes promoting one digest across environments trustworthy. Override
# per repository if a service genuinely needs a moving tag.
repositories = {
  api = {}
  web = {}
}

# Cost control. ECR bills per GB per month and nothing expires by itself; a
# build per commit leaves an untagged layer set behind every time a tag moves.
untagged_expire_days = 14
max_image_count      = 30
