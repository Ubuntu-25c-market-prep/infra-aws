# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.
#
# This repository is public, so the example carries placeholders rather than the
# live account ids. Get them from `aws organizations list-accounts`.
#
# Runs in the WORKLOAD account. Assume into it from management first:
#   aws sts assume-role \
#     --role-arn arn:aws:iam::REPLACE-WORKLOAD-ACCOUNT-ID:role/OrganizationAccountAccessRole \
#     --role-session-name bootstrap

account_id = "REPLACE-WORKLOAD-ACCOUNT-ID" # Dev - the single workload account
region     = "us-east-1"
org_prefix = "u25c"

# The management account runs budgets/ but stores its state in this bucket.
state_reader_account_ids = ["REPLACE-MANAGEMENT-ACCOUNT-ID"]

# Account-level budget. The org-wide ceiling with the enforcing freeze action
# lives in budgets/, which runs in the management account.
monthly_budget_usd    = "200"
anomaly_threshold_usd = 25

# Use a role address the whole team can reach, not a personal mailbox.
alert_emails = [
  "you+u25c-alerts@example.com",
]

# Set to your organisation id to make the trail an ORGANISATION trail. Requires
# this account to be a CloudTrail delegated administrator - see ../organization.
organization_id                    = ""
# Required when organization_id is set - the org trail ARN lives here.
organization_management_account_id = ""
# Every account the org trail captures - each needs to be in the KMS encryption context.
organization_member_account_ids    = []
